rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // syncCode = l'UID Firebase Auth du propriétaire dès qu'une session est active
    // (voir navlog.html _getSyncCode()) : ne restreindre l'accès qu'à ce même UID.
    match /navlog/{syncCode}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == syncCode;
    }
  }
}
