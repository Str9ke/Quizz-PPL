sier modèles</a></li>\n                                    <li><a href=\"/FAQ-modeles.php\">FAQ Modèles</a></li>\n                                    <li><a href=\"/dossier/nuages/index.php\">Les nuages</a></li>\n                                    <li><a href=\"http://www.meteo-paris.com/chronique/\" target=\"_blank\">Chronique 1850</a></li>\n                                    <li><a href=\"http://www.meteo-paris.com/almanach/\" target=\"_blank\">Almanach</a></li>\n                                </ul>\n                                                            </div>\n                        </li>\n                        <li id=\"menu_logiciels\">\n                            <h3 id='menutitre7'>Logiciels</h3>\n                            <div id=\"menu7\"  style='display: block'  >\n                                <ul>\n                                    <li><a href=\"/logiciels_meteo/gfs/index.php\">GFS</a></li>\n                                    <li><a href=\"/logiciels_meteo/cartes_meteo/index.php\">Éditeur de cartes</a></li>\n                                </ul>\n                            </div>\n                        </li>\n                    </ul>\n                </div>\n            </td>\n        </tr>\n\n        <tr valign=\"top\">\n            <td width=\"140\" height=\"30\" align=\"center\">&nbsp;</td>\n        </tr>\n    </tbody>\n</table>\n<script type=\"text/javascript\">\n\n    function GetObjectFromNameCustom( nom )\n    {\n        var Pdiv = undefined;\n\n        if ( document.getElementById && document.getElementById( nom ))\n        {\n            Pdiv = document.getElementById( nom );        \n        }    \n        else if ( document.all && document.all[ nom ] )\n        {\n            Pdiv = document.all[ nom ];\n        }\n        else if ( document.layers && document.layers[ nom ] )\n        {\n            Pdiv = document.layers[ nom ];\n        }\n        return Pdiv;\n    }\n\n    function DivStatus( nom )\n    {\n        var divID = nom;\n        Pdiv = GetObjectFromNameCustom(nom);    \n        if ( Pdiv != undefined)\n        {\n            Pdiv.style.display = ( Pdiv.style.display == 'none') ? 'block' : 'none';        \n            EcrireCookie(nom, Pdiv.style.display);\n        }\n    }\n\n\n    function EcrireCookie(nom, valeur)\n    {        \n        date=new Date;\n        date.setMonth(date.getMonth()+1);\n        document.cookie = nom + \"=\" + escape(valeur) + \"; expires=\" + date.toUTCString() + \"; path=/; domain=.meteociel.fr;secure\";    }\n    \n    function EcrireCookieNoExpire(nom, valeur)\n    {        \n        document.cookie = nom + \"=\" + escape(valeur) + \"; expires=Fri, 31 Dec 9999 23:59:59 GMT; path=/; domain=.meteociel.fr;secure\";    }\n\n    function ChangeSigne ( nom )\n    {\n        var divID = nom;\n        Pdiv = GetObjectFromNameCustom(divID);\n        if (Pdiv != undefined )\n        {\n            var OldImg = Pdiv.innerHTML;    \n            if (OldImg == '<img src=\"//static.meteociel.fr/Banner/plus.png\">')\n            {\n                Pdiv.innerHTML = '<img src=\"//static.meteociel.fr/Banner/moins.png\">';\n            }\n            else if (OldImg == '<img src=\"//static.meteociel.fr/Banner/moins.png\">')\n            {\n                Pdiv.innerHTML = '<img src=\"//static.meteociel.fr/Banner/plus.png\">';\n            }\n        }\n    }\n\n    // init the menu script\n    menuIndex = 1;\n    var ms = new Array();\n    var im = new Array();\n    ms[1] = 'none';\nim[1] = '//static.meteociel.fr/Banner/moins.png';\nms[2] = 'none';\nim[2] = '//static.meteociel.fr/Banner/moins.png';\nms[3] = 'none';\nim[3] = '//static.meteociel.fr/Banner/moins.png';\nms[4] = 'none';\nim[4] = '//static.meteociel.fr/Banner/moins.png';\nms[5] = 'none';\nim[5] = '//static.meteociel.fr/Banner/moins.png';\nms[6] = 'none';\nim[6] = '//static.meteociel.fr/Banner/moins.png';\nms[7] = 'none';\nim[7] = '//static.meteociel.fr/Banner/moins.png';\nms[8] = 'none';\nim[8] = '//static.meteociel.fr/Banner/moins.png';\nms[9] = 'none';\nim[9] = '//static.meteociel.fr/Banner/moins.png';\n\n    var menuItem;\n    menuItem = GetObjectFromNameCustom('menutitre' + menuIndex);\n    while( menuItem != undefined )\n    {     \n\n        menuItem.myId = menuIndex;        \n        menuItem.onclick = function() {  ChangeSigne('pm' + this.myId); DivStatus( 'menu' + this.myId );  };\n\n        // add plus/minus\n        var pm = document.createElement(\"div\");\n        pm.id = 'pm' + menuIndex;\n        pm.className=\"plusmoins\";\n        var img = document.createElement(\"img\");\n        img.src = im[menuIndex];\n        pm.appendChild(img);\n        menuItem.appendChild(pm);\n        menuIndex++;\n        menuItem = GetObjectFromNameCustom('menutitre' + menuIndex);\n    }\n </script>\n</td>\r\n        <td valign=\"top\" width=\"815\">    \r\n            <table align=\"center\" cellspacing=\"1\" width=\"810\">\r\n              <tbody>\r\n                <tr class=\"titre_categorie\">\r\n                  <td><b><font size=\"2\" face=\"Arial\">&nbsp;&bull; </font></b><strong>Mod&egrave;le GFS 0.25&deg; HR </strong> [ <a href='/modeles/gfse_cartes.php'> GFS Europe </a> ] - [ <a href='/modeles/ecmwf/'> ECMWF </a> ] - [ <a href='/modeles/ukmo2.php'> UKMO </a> ] - [ <a href='/modeles/ukmo2.php'> UKMO </a> ] - [ <a href='/modeles/gefs_cartes.php'> Ens. GEFS </a> ] - [ <a href='/modeles/geme_cartes.php'>GEM</a> ] - [ <a href='/modeles/jma.php'> JMA </a> ] - [ <a href='/modeles/navgeme_cartes.php'> NAVGEM</a> ] - [ <a href='/modeles/wrfnmm.php'> WRF NMM </a> ]</td>\r\n                </tr>\r\n                <tr bgcolor=\"#97bedd\">\r\n                  <td class=\"texte\"><table width=\"810\" border=\"0\" cellpadding=\"0\" cellspacing=\"5\">\r\n                      <tbody>\r\n                        <tr align=\"left\" valign=\"top\">\r\n                          <td  bgcolor=\"#DDF7F2\" class=\"texte\">\r\n                          \r\n                