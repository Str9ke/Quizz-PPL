eteociel.fr/images/drapeaux/de.gif'> Allemagne </a> - &nbsp;<a href=\"/modeles/gfs/italie/resume/72h.htm\"><img src='//static.meteociel.fr/images/drapeaux/it.gif'> Italie </a> - &nbsp;<a href=\"/modeles/gfs/espagne/resume/72h.htm\"><img src='//static.meteociel.fr/images/drapeaux/es.gif'> Espagne </a> - &nbsp;<a href=\"/modeles/gfs/grece/resume/72h.htm\"><img src='//static.meteociel.fr/images/drapeaux/gr.gif'> Gr&egrave;ce </a>&nbsp;<font color=red><b>NEW!</b></font><br><br><img id=image name=image title='Modele GFS - Carte prévisions RR/PrMSL/Nébu ' alt='Modele GFS - Carte prévisions ' src='https://modeles2.meteociel.fr/modeles_gfs/runs/2026031306/72-102.GIF?13-6'><center><table border=0><tr><td width=100 align=center><input type=button name=slower id=slower onclick='javascript:slower();' value='&lt;&lt;'> &nbsp;  <input type=button name=faster id=faster onclick='javascript:faster();' value='&gt;&gt;'></td><td><input oninput='updateSliderEch();' onchange='updateSliderEch();'  type=\"range\" id=\"timeline\" class=\"modelslider\" name=\"timeline\" style=\"width:500px;\" min=\"0\" max=\"53\" value=\"23\"></td></tr></table><br><img border=0 src=\"//static.meteociel.fr/cartes_obs/0h.gif\">&nbsp; Run 0h &nbsp;&nbsp;&nbsp;&nbsp;<img border=0 src=\"//static.meteociel.fr/cartes_obs/6h.gif\">&nbsp; Run 6h&nbsp;&nbsp;&nbsp;&nbsp;<img border=0 src=\"//static.meteociel.fr/cartes_obs/12h.gif\">&nbsp; Run 12h&nbsp;&nbsp;&nbsp;&nbsp;<img border=0 src=\"//static.meteociel.fr/cartes_obs/18h.gif\">&nbsp; Run 18h&nbsp;&nbsp;&nbsp;&nbsp;</center></td></tr></table></center><br>  <br> <i><b> Quelques précisions : </b></i><br><br>Pour plus d'informations sur les cartes et leur signification, cliquer <a href='/FAQ-modeles.php'>ici</a><br><br>Ces cartes sont réalisées à partir des données brutes du modèle américain <b>GFS</b> (Global Forecast System) haute résolution (0.25deg). <br>Les réactualisations commencent vers  4h30, 10h30, 16h30 et 22h30 et une réactualisation complète dure environ 1h30. <br> Les diodes colorées près des échéances permettent de suivre l'avancement de la génération des cartes de prévisions du modèle GFS.                            </td>\r\n                        </tr>\r\n                        <tr align=\"left\" valign=\"top\">\r\n                          <td  bgcolor=\"#DDF7F2\" class=\"texte\">\r\n                            <p>\r\n                                <center>\r\n                                    <center>\r\n<table border=0 width=655 style='width:655px' height=280>\r\n  <tr valign=top>                                  \r\n    <td width=336 align=right><div style='min-height:250px;'><div id='div-gpt-ad-1582242954770-0' style='min-width: 200px; min-height: 100px;'><script> googletag.cmd.push(function() { googletag.display('div-gpt-ad-1582242954770-0'); }); </script></div></div></td><td width=336 align=left><div style='min-height:250px;'><div id='div-gpt-ad-1582243355333-0' style='min-width: 200px; min-height: 100px;'><script> googletag.cmd.push(function() { googletag.display('div-gpt-ad-1582243355333-0'); }); </script></div></div></td>   </tr>\r\n</table>\r\n</center>\r\n                                </center>\r\n                            </p>\r\n                            </td>\r\n                        </tr>\r\n                      </tbody>\r\n                  </table></td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n          </td>\r\n    </tr>\r\n    </tbody>\r\n</table>\r\n<table width=\"980\" border=\"0\" align=\"center\" cellpadding=\"0\" cellspacing=\"5\" bgcolor=\"#97bedd\">\r\n  <tbody>\r\n    <tr>\r\n      <td height=\"14\" align=\"center\" bgcolor=\"#DDF7F2\" class=\"Style1\">\r\n          <span class=\"texte\">\r\n            <span class=\"texte\"><a href=\"http://www.meteociel.fr/\" target=\"_blank\">Meteociel</a>&trade; | © 2004 - 2026 \r\n| <a href=\"http://forums.meteociel.fr\" title=\"Forums Météociel\" target=\"_blank\">Forums Météo</a> </a> \r\n| <a 