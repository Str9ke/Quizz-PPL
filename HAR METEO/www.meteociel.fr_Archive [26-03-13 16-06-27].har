d);\r\n}\r\nfunction stopAnim()\r\n{\r\n    animated = 0;\r\n    document.getElementById(\"animer\").innerHTML = \"Anim.\";\r\n    document.getElementById(\"animer\").href = \"javascript:startAnim();\";\r\n    document.getElementById(\"slower\").innerHTML = \"&lt;\";\r\n    document.getElementById(\"faster\").innerHTML = \"&gt;\";\r\n    clearTimeout(anim);\r\n}\r\nfunction faster()\r\n{\r\n    if(animated == 1)\r\n    {\r\n        speed = speed - 100;\r\n        if( speed < 100) speed = 100;\r\n    }\r\n    else\r\n    {\r\n        curImage = curImage + 1;\r\n        if(curImage > numTotalImages-1) curImage = numTotalImages-1;\r\n        document.getElementById(\"image\").src = imgArray[curImage];\r\n        document.getElementById(\"timeline\").value = curImage;\r\n    }\r\n}\r\nfunction slower()\r\n{\r\n    if(animated == 1)\r\n    {\r\n        speed = speed + 100;\r\n        if( speed > 2000) speed = 2000;\r\n    }\r\n    else\r\n    {\r\n        curImage = curImage - 1;\r\n        if(curImage < 0) curImage = 0;\r\n        document.getElementById(\"image\").src = imgArray[curImage];\r\n        document.getElementById(\"timeline\").value = curImage;\r\n    }\r\n}\r\n\r\n    function updateSliderEch()\r\n    {\r\n        var ci = document.getElementById(\"timeline\").value;\r\n        curImage = ci;\r\n        document.getElementById(\"image\").src = imgArray[curImage]; \r\n    }\r\n\r\n\r\n    function changeImage(image,num) \r\n    {\r\n        document.getElementById('image').src = image;\r\n        curImage = num;\r\n        document.getElementById(\"timeline\").value = curImage;  \r\n    }\r\n    \r\n    images = new Array();\r\n    var eh = 0;\r\n    var numImages = 0;\r\n    var linklink = unescape(window.location.pathname);\r\n    \r\n    function chargeFini()\r\n    {\r\n        numImages++;\r\n    \r\n        if (document.all)\r\n        {\r\n            document.all(\"precharge\").innerHTML = numImages + \"/\" + numTotalImages;\r\n        }\r\n        e