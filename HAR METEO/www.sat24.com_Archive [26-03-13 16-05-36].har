ess\":false,\"type\":\"1st_party\",\"cookieMaxAgeSeconds\":15811200,\"lang_urls\":[],\"namespaces\":{\"num\":25458}},{\"id\":\"getsitecon-MqxYtpwd\",\"didomiId\":\"getsitecon-MqxYtpwd\",\"name\":\"Getsitecontrol\",\"policyUrl\":\"https://getsitecontrol.com/privacy\",\"purposeIds\":[\"cookies\",\"cookies_measure\",\"load_external_content\"],\"legIntPurposeIds\":[],\"usesNonCookieAccess\":false,\"type\":\"3rd_party\",\"lang_urls\":[],\"namespaces\":{\"num\":30953}},{\"id\":\"localfocu-tdVLhMRr\",\"didomiId\":\"localfocu-tdVLhMRr\",\"name\":\"LocalFocus\",\"policyUrl\":\"https://www.anp.nl/privacy-en-voorwaarden\",\"purposeIds\":[\"load_external_content\"],\"legIntPurposeIds\":[],\"usesNonCookieAccess\":false,\"type\":\"3rd_party\",\"lang_urls\":[],\"namespaces\":{\"num\":30970}}],\"google\":{\"fullATP\":true}},\"apiKey\":\"57fe2cce-0830-497c-a618-90af555dae38\",\"customPurposes\":[{\"id\":\"load_external_content\",\"name\":{\"en\":\"Load content from external parties\",\"nl\":\"Content van externe partijen laden\"},\"description\":{\"en\":\"\",\"nl\":\"Deze cookies stellen ons in staat om content van externe partijen te tonen.\"},\"namespaces\":{\"num\":768}},{\"id\":\"cookies_measure\",\"name\":{\"en\":\"Cookies which allow us to measure the use of the website\",\"nl\":\"Cookies waarmee wij het gebruik van de website kunnen meten\"},\"description\":{\"en\":\"\",\"nl\":\"Deze cookies geven ons informatie over de kwaliteit en effectiviteit van de door ons geleverde diensten.\"},\"namespaces\":{\"num\":15372}},{\"id\":\"functional\",\"name\":{\"en\":\"Cookies that ensure the website properly works\",\"nl\":\"Cookies die ervoor zorgen dat de website naar behoren functioneert\"},\"description\":{\"en\":\"\",\"nl\":\"Deze cookies zijn nodig voor het goed laten functioneren van Infoplaza websites.\"},\"namespaces\":{\"num\":15371}},{\"id\":\"audiencem-hJxaeGrR\",\"name\":{\"ar\":\"قياس الجمهور\",\"bg\":\"Измерването на аудиторията\",\"ca\":\"Mesura de l'audiència\",\"cs\":\"Měření návštěvnosti\",\"da\":\"Publikumsmåling\",\"de\":\"Reichweitenmessung\",\"el\":\"Μέτρηση κοινού\",\"en\":\"Audience Measurement\",\"es\":\"Medición de la audiencia\",\"et\":\"Külastajaskonna mõõtmine\",\"fi\":\"Yleisön mittaus\",\"fr\":\"Mesure d'audience\",\"he\":\"מדידת קהל\",\"hr\":\"Procjena publike\",\"hu\":\"Közönségmérés\",\"id\":\"Asesmen Audiens\",\"it\":\"Misurazione del pubblico.\",\"ja\":\"オーディエンス測定\",\"ko\":\"시청자 측정\",\"lt\":\"Auditorijos matavimas\",\"lv\":\"Auditorijas mērījumi\",\"ms\":\"Pengukuran Audiens\",\"nl\":\"Publieksmeting\",\"no\":\"Publikumsmålinger\",\"pl\":\"Pomiar audytorium\",\"pt\":\"Medição de públicos-alvo\",\"ro\":\"Măsurarea audienței\",\"ru\":\"Измерение показателей аудитории\",\"sk\":\"Meranie publika\",\"sl\":\"Merjenje občinstva\",\"sr\":\"Мерење публике\",\"sv\":\"Användarmätning\",\"sw\":\"Kipimo cha Hadhira\",\"th\":\"การวัดผลผู้ชม\",\"tr\":\"İzleyici Ölçümü\",\"uk\":\"Вимірювання показників аудиторії\",\"vi\":\"Đo lường Đối tượng\",\"fil\":\"Pagsukat ng Audience\",\"ar-JO\":\"قياس الجمهور\",\"az-AZ\":\"İzləyici Ölçümü\",\"bn-IN\":\"অডিয়েন্স মেজারমেন্ট\",\"de-AT\":\"Zielgruppenmessung\",\"de-CH\":\"Zielgruppenmessung\",\"en-NZ\":\"Audience Measurement\",\"fr-BE\":\"Mesure de l'audience\",\"fr-CA\":\"Audimétrie\",\"hi-IN\":\"ऑडियंस का मापन\",\"mk-MK\":\"Мерење на бројот на посетители\",\"nl-BE\":\"Publieksmetingen\",\"pt-BR\":\"Análise do público-alvo\",\"zh-CN\":\"受众测量\",\"zh-TW\":\"受眾計量\"},\"description\":{\"ar\":\"يتيح لك قياس الجمهور جمع المعلومات الإحصائية عن بيانات زيارات الموقع لتحسين تجربة المستخدم وأداء الموقع.\",\"bg\":\"Измерването на аудиторията позволява да събирате статистическа информация за данните за трафика с цел подобряване на потребителското изживяване и ефективността на сайта.\",\"ca\":\"La mesura de l'audiència us permet recollir informació estadística sobre el trànsit de dades per poder millorar l'experiència de l'usuari i el rendiment del lloc.\",\"cs\":\"Měření návštěvnosti vám umožňuje shromažďovat statistické informace týkající se údajů o provozu za účelem zlepšení uživatelské zkušenosti a výkonu webu.\",\"da\":\"Publikumsmåling giver dig mulighed for at indsamle statistiske oplysninger om trafikdata for at forbedre brugeroplevelsen og sitets præstationer.\",\"de\":\"Reichweitenmessung ermöglicht es statistische Informationen über Datenflüsse zu sammeln, um damit das Benutzererlebnis auf einer Webseite und die Performanz derselben zu verbessern.\",\"el\":\"Η μέτρηση κοινού σάς επιτρέπει τη συγκέντρωση στατιστικών στοιχείων για τα δεδομένα κίνησης προκειμένου να βελτιωθεί η εμπειρία χρήστη και οι επιδόσεις του ιστότοπου.\",\"en\":\"Audience measurement enables you to collect statistical information on traffic data in order to improve user experience and site performance.\",\"es\":\"El seguimiento de la audiencia permite recoger datos estadísticos sobre el tráfico para mejorar la experiencia del usuario y las performancias del sitio.\",\"et\":\"Külastajaskonna mõõtmine lubab koguda statistilist teavet liiklusandmete kohta, et parandada kasutuskogemust ja saidi toimivust\",\"fi\":\"Yleisön mittauksen avulla voit kerätä tilastotietoja kävijädatasta parantaaksesi käyttökokemusta sekä sivuston tehokkuutta.\",\"fr\":\"Le suivi d'audience permet de collecter des données statistiques de fréquentation afin d'améliorer l'expérience utilisateur et les performances du site.\",\"he\":\"מדידת הקהל מאפשרת לך לאסוף מידע סטטיסטי על נתוני התעבורה על מנת לשפר את חוויית המשתמש וביצועי האתר.\",\"hr\":\"Procjena publike omogućuje vam prikupljanje statističkih podataka o prometu radi unaprjeđenja korisničkog iskustva i performansi web-stranice.\",\"hu\":\"A közönségmérés lehetővé teszi önnek az adatforgalomra vonatkozó statisztikai adatok gyűjtését a felhasználói élmény és a teljesítmény fokozása érdekében.\",\"id\":\"Dengan asesmen audiens, Anda dapat menghimpun informasi statistik tentang data lalu lintas untuk meningkatkan pengalaman pengguna dan performa situs.\",\"it\":\"La misurazione del pubblico consente di raccogliere informazioni statistiche sui dati di traffico per il miglioramento dell'esperienza di utilizzo e delle prestazioni del sito.\",\"ja\":\"オーディエンス測定を使用すると、トラフィックデータに関する統計情報を収集して、ユーザーエクスペリエンスとサイトのパフォーマンスを向上させることができます。\",\"ko\":\"시청자 측정을 통해 트래픽 데이터에 대한 통계 정보를 수집하여 사용자 경험과 사이트 성능을 향상시킬 수 있습니다.\",\"lt\":\"Naudodamiesi auditorijos matavimu, galėsite rinkti statistinę informaciją apie eismo duomenis, kad pagerintumėte naudotojo patirtį ir svetainės veikimo savybes.\",\"lv\":\"Auditorijas mērījumi ļauj jums ievākt statistikas datums par datu plūsmu, lai uzlabotu lietotāju pieredzi un vietnes veiktspēju.\",\"ms\":\"Pengukuran audiens membolehkan anda untuk mengumpul maklumat statistik mengenai data trafik untuk menambah baik pengalaman pengguna dan prestasi laman.\",\"nl\":\"Met publieksmeting kunt u statistische verkeersgegevens verzamelen om de gebruikservaring en de prestaties van de website te verbeteren.\",\"no\":\"Publikumsmålinger lar deg samle statistikk om trafikken på nettstedet og i appen, og kan være nyttig for å gjøre brukeropplevelsen og ytelsen bedre.\",\"pl\":\"Pomiar audytorium pozwala na zbieranie informacji statystycznych o ruchu. Pomaga to w ulepszaniu działania strony oraz poprawiania wrażeń z jej użytkowania.\",\"pt\":\"A medição de públicos-alvo permite-lhe recolher informações estatísticas sobre os dados de tráfego para melhorar a experiência do utilizador e o desempenho do site.\",\"ro\":\"Măsurarea audienței vă permite să colectați informații statistice despre traficul de date pentru a îmbunătăți experiența utilizatorilor și performanța site-ului.\",\"ru\":\"Измерение показателей аудитории позволяет собирать статистические данные о трафике и совершенствовать интерфейс и производительность сайта.\",\"sk\":\"Meranie publika vám umožňuje zhromažďovať štatistické informácie týkajúce sa údajov o návštevnosti a zlepšovať tak dojem používateľa a výkonnosť webu.\",\"sl\":\"Merjenje občinstva vam omogoča zbiranje statističnih informacij o podatkih prometa za izboljšanje uporabniške izkušnje in delovanja strani.\",\"sr\":\"Мерење публике вам омогућује прукупљање статистичких информација везаних за податке о саобраћају у циљу побољшања корисничког искуства и перформанси сајта.\",\"sv\":\"Användarmätning gör att du kan inhämta statistiska uppgifter om trafikdata för att kunna förbättra användarupplevelsen och webbplatsens prestanda.\",\"sw\":\"Kipimo cha hadhira kinakuwezesha ukusanye maelezo ya kitakwimu kuhusu data ya wanaotembelea ili uboreshe hali ya utumiaji na utendaji wa tovuti.\",\"th\":\"การวัดผลผู้ชมช่วยให้คุณสามารถรวบรวมข้อมูลทางสถิติเกี่ยวกับข้อมูลการเข้าชม เพื่อปรับปรุงประสบการณ์ของผู้ใช้และประสิทธิภาพของไซต์\",\"tr\":\"İzleyici ölçümü, kullanıcı deneyimini ve site performansını geliştirebilmeniz için trafik verileri ile ilgili istatistiksel bilgileri toplamanıza imkan tanır.\",\"uk\":\"Вимірювання показників аудиторії дає змогу збирати статистичні відомості про трафік та вдосконалювати інтерфейс і продуктивність сайту.\",\"vi\":\"Đo lường đối tượng cho phép bạn thu thập thông tin thống kê về dữ liệu lưu lượng truy cập để cải thiện trải nghiệm người dùng và hiệu suất trang web.\",\"fil\":\"Nagbibigay-daan sa iyo ang pagsukat ng audience na mangolekta ng estadistikang impormasyon sa traffic data para pahusayin ang experience ng user at performance ng site.\",\"ar-JO\":\"يساعدك قياس الجمهور على جمع المعلومات الإحصائية حول بيانات المرور لتحسين تجربة المستخدم وأداء الموقع.\",\"az-AZ\":\"İzləyici ölçümü, istifadəçi təcrübəsini və saytın performansını yaxşılaşdırmaq üçün trafik məlumatları haqqında statistik məlumat toplamağa imkan verir.\",\"bn-IN\":\"ব্যবহারকারীর অভিজ্ঞতা এবং সাইটের পারফরমেন্স উন্নত করার জন্য অডিয়েন্স মেজারমেন্ট আপনাকে ট্রাফিক ডেটার পরিসংখ্যানগত তথ্য সংগ্রহ করতে সাহায্য করে।\",\"de-AT\":\"Mithilfe der Zielgruppenmessung lassen sich statistische Informationen über den Datenverkehr sammeln, um das Benutzererlebnis und die Leistung der Website zu verbessern.\",\"de-CH\":\"Mithilfe der Zielgruppenmessung lassen sich statistische Informationen über den Datenverkehr sammeln, um das Benutzererlebnis und die Leistung der Website zu verbessern.\",\"en-NZ\":\"Audience measurement enables you to collect statistical information on traffic data in order to improve user experience and site performance.\",\"fr-BE\":\"Grâce à la mesure d'audience, vous pouvez recueillir des données statistiques sur les données afin d'améliorer l'expérience utilisateur et les performances du site\",\"fr-CA\":\"L'audimétrie vous permet de recueillir des renseignements statistiques sur les données de trafic afin d'améliorer l'expérience de l'utilisateur et les performances du site.\",\"hi-IN\":\"ऑडियंस मापन आपको ट्रैफिक डेटा पर स्टैटिस्टिकल जानकारी इकट्ठा करने में सक्षम बनाता है ताकि यूज़र के अनुभव और साइट परफॉर्मेंस में सुधार किया जा सके।\",\"mk-MK\":\"Мерењето на бројот на посетители ви овозможува да собирате статистички информации за податоците за посетеноста со цел да се подобрат корисничкото искуство и перформансите на страницата.\",\"nl-BE\":\"Met behulp van publieksmetingen kan u statistische informatie over verkeersgegevens verzamelen om de gebruikerservaring en websiteprestaties te verbeteren.\",\"pt-BR\":\"A análise do público-alvo permite coletar informações estatísticas sobre os dados de tráfego para melhorar a experiência do usuário e o desempenho do site.\",\"zh-CN\":\"受众测量让您可以收集流量数据的统计信息，从而优化用户体验和网站性能。\",\"zh-TW\":\"「受眾計量」能為你收集有關流量數據的統計資訊，可協助改善用戶體驗及網站效能。\"},\"namespaces\":{\"num\":8598}}],\"deploymentId\":\"RfLD3dX4\",\"country\":\"nl\",\"consentDuration\":15811200,\"sdkVersion\":null},\"user\":{\"bots\":{\"consentRequired\":false,\"types\":[\"crawlers\",\"performance\"]},\"country\":\"SE\",\"region\":\"O\"},\"theme\":{\"css\":\"/** Global styles */\\n#didomi-host {\\n    --svg-decline: url(\\\"data:image/svg+xml;base64,\\\");\\n    --svg-accept: url(\\\"data:image/svg+xml;base64,\\\");\\n    --svg-arrow-down: url(\\\"data:image/svg+xml;base64,\\\");\\n    --svg-arrow-right: url(\\\"data:image/svg+xml;base64,\\\");\\n    --svg-arrow-up: url(\\\"data:image/svg+xml;base64,\\\");\\n}\\n\\n#didomi-host h1,\\n#didomi-host h2 {\\n    color: #2E2E2B;\\n}\\n\\n#didomi-host p {\\n    color: #303233;\\n}\\n\\n/** First screen */\\n#didomi-host .didomi-popup-notice.didomi-popup-notice-with-data-processing {\\n  padding: 1.5rem !important;\\n}\\n\\n\\n#didomi-host .didomi-exterior-border {\\n    border: none;\\n}\\n\\n#didomi-host .didomi-popup-backdrop {\\n    background-color: #1d2837d6;\\n}\\n\\n#didomi-host .didomi-popup-container {\\n    border: none;\\n    border-radius: 20px;\\n}\\n\\n#didomi-host .login-block {\\n    margin-top: 1rem;\\n}\\n\\n/** Standard button */\\n#didomi-host .didomi-button {\\n    min-height: 50px;\\n    border-radius: 5px !important;\\n    transition: 100ms ease-in;\\n    border: none;\\n    text-wrap: balance;\\n}\\n\\n#didomi-host .didomi-popup-notice .didomi-popup-notice-buttons .didomi-button.didomi-learn-more-button {\\n    display: none !important;\\n    visibility: hidden !important;\\n    width: 0 !important;\\n    border: none !important;\\n    padding: 0 !important;\\n    margin: 0 !important;\\n    min-width: 0 !important;\\n}\\n\\n#didomi-host .didomi-button-highlight:hover {\\n    background-color: #025AB8 !important;\\n    opacity: 1 !important;\\n}\\n\\n#didomi-host .didomi-disagree-button {\\n    background-image: linear-gradient(to right, rgb(250, 204, 21), rgb(234, 179, 8), rgb(202, 138, 4));\\n}\\n\\n#didomi-host .didomi-disagree-button:hover {\\n    background-image: linear-gradient(to right, rgb(234, 179, 8), rgb(161, 98, 7));\\n}\\n\\n#didomi-host .didomi-popup-container .didomi-popup-notice-logo-container {\\n  display: flex;\\n  justify-content: center;\\n}\\n\\n#didomi-host .didomi-popup-notice .didomi-popup-notice-logo {\\n  width: 220px;\\n  margin: 0;\\n}\\n\\n/** Second screen */\\n#didomi-host .didomi-consent-popup-title {\\n  font-size: 1.2rem;\\n}\\n\\n#didomi-host .didomi-popup-body {\\n    padding: 10px 20px 20px 20px;\\n}\\n\\n#didomi-host .didomi-popup-body .didomi-popup-body-section {\\n  margin: 1rem 0;\\n}\\n\\n#didomi-host .didomi-consent-popup-body .didomi-consent-popup-body__title {\\n    margin: 0;\\n}\\n\\n#didomi-host .didomi-consent-popup-purpose__buttons {\\n    margin-left: auto !important;\\n}\\n\\n#didomi-host .didomi-consent-popup-purpose__buttons .didomi-components-radio {\\n    gap: 0.5rem;\\n}\\n\\n#didomi-host .didomi-consent-popup-purpose__buttons .didomi-components-radio__option {\\n    color: #0282EB !important;\\n    height: 34px;\\n    border-radius: 5px;\\n    border: 1px solid #0282EB;\\n    margin: 0 !important;\\n}\\n\\n#didomi-host .didomi-consent-popup-purpose__buttons .didomi-components-radio__option span {\\n    font-size: 0.9rem;\\n}\\n\\n#didomi-host .didomi-consent-popup-purpose__buttons .didomi-components-radio__option--selected {\\n    background-color: #0282EB !important;\\n    color: white;\\n    height: 34px;\\n    border-radius: 5px;\\n    border: none !important;\\n}\\n\\n#didomi-host .didomi-consent-popup-purpose__buttons .didomi-components-radio__option--selected span {\\n    color: white;\\n}\\n\\n#didomo-host .didomi-popup-notice-text {\\n  line-height: 175%;\\n}\\n\\n#didomi-host .didomi-components-radio__option {\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n}\\n\\n#didomi-host .didomi-notice-data-processing-container {\\n    text-align: inherit;\\n}\\n\\n#didomi-host .didomi-popup-notice .didomi-popup-notice-buttons {\\n    justify-content: center;\\n}\\n\\n#didomi-host .didomi-consent-popup-body .didomi-consent-popup-body__title {\\n  display: none !important;\\n}\\n\\n#didomi-host .didomi-consent-popup-body {\\n  border-bottom: 1px solid #ccc;\\n  padding: 20px;\\n  overflow-y: scroll;\\n  max-height: 65vh;\\n}\\n\\n#didomi-host .didomi-popup-footer {\\n  border-radius: 20px;\\n  padding: 20px;\\n  height: auto;\\n}\\n\\n#didomi-host .didomi-popup-footer .didomi-popup-actions button {\\n    margin: 0;\\n}\\n\\n#didomi-host .didomi-popup-footer .didomi-popup-actions button + button {\\n    margin-left: 1rem;\\n}\\n\\n#didomi-host .didomi-components-accordion .trigger-icon {\\n    visibility: hidden;\\n    position: relative;\\n    width: 25px;\\n}\\n\\n#didomi-host .didomi-components-accordion .trigger-icon:before {\\n    content: '';\\n    width: 100%;\\n    height: 100%;\\n    display: block;\\n    background-color: #999;\\n    mask-repeat: no-repeat;\\n    mask-position: 0 0;\\n    mask-image: var(--svg-arrow-down);\\n    visibility: visible;\\n    position: absolute;\\n    left: -5px;\\n    top: -1px;\\n}\\n\\n#didomi-host .didomi-components-accordion [aria-expanded=true] .trigger-icon:before {\\n    mask-image: var(--svg-arrow-up);\\n}\\n\\n\\n#didomi-host .didomi-components-accordion .didomi-components-radio__option {\\n    border-radius: 100% !important;\\n    width: 40px !important;\\n    height: 40px !important;\\n    padding: 0 !important;\\n    margin: 2px;\\n}\\n\\n#didomi-host .didomi-components-accordion .didomi-components-radio__option svg,\\n#didomi-host .didomi-components-accordion .didomi-components-radio__option span {\\n    display: none;\\n}\\n\\n#didomi-host .didomi-components-accordion .didomi-components-radio__option::before {\\n    content: '';\\n    width: 100%;\\n    height: 100%;\\n    display: block;\\n    background-color: #999;\\n    mask-repeat: no-repeat;\\n    mask-position: center center;\\n}\\n\\n#didomi-notice-learn-more-button {\\n    order: 3;\\n}\\n\\n\\n#didomi-host .didomi-components-accordion .didomi-components-radio__option.didomi-components-radio__option--disagree::before,\\n#didomi-host .didomi-components-accordion .didomi-components-radio__option.didomi-components-radio__option--agree::before {\\n    background-color: #fff;\\n}\\n\\n#didomi-host .didomi-components-accordion .didomi-components-radio__option:first-child {\\n    margin-right: 8px;\\n}\\n\\n/* decline circle  */\\n#didomi-host .didomi-components-accordion .didomi-components-radio__option::before {\\n    mask-image: var(--svg-decline);\\n}\\n\\n/* accept circle */\\n#didomi-host .didomi-components-accordion .didomi-components-radio__option:last-child::before {\\n    mask-image: var(--svg-accept);\\n}\",\"font\":\"\\\"Open Sans\\\", Arial, sans-serif\",\"color\":\"#2a59b5\",\"linkColor\":\"#2a59b5\"},\"notice\":{\"position\":\"popup\",\"showDataProcessing\":false,\"daysBeforeShowingAgain\":30,\"enableBulkActionOnPurposes\":true,\"content\":{\"popup\":{\"de\":\"<h2>Wählen Sie Ihr Erlebnis</h2>\\n<p>Mit Premium haben Sie die Wahl: Für nur 3,49 pro Jahr ohne Werbung oder für personalisierte Werbung. <a href=\\\"javascript:window.auth.login();\\\">Haben Sie Premium? Hier anmelden</a></p><br />Mit Ihrer Zustimmung verwenden wir und unsere <a href=\\\"javascript:Didomi.preferences.show('vendors')\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">{numberOfPartners}</a> Partner Cookies und ähnliche Technologien zur Verarbeitung personenbezogener Daten, wie Informationen über Ihren Website-Besuch, IP-Adressen und Cookie-IDs. Sie können Ihre Einwilligung jederzeit widerrufen, indem Sie unten auf \\\"Cookie-Einstellungen\\\" klicken oder über unsere <a href=\\\"https://www.infoplaza.com/nl/disclaimer-en-privacy\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">Cookie- und Datenschutzrichtlinie</a> für weitere Informationen.\",\"el\":\"<h2>Επιλέξτε την εμπειρία σας</h2>\\n<p>Έχετε την επιλογή να μην απολαμβάνετε διαφημίσεις με μόλις 3,49 ετησίως με το Premium ή να συμφωνήσετε με εξατομικευμένες διαφημίσεις. <a href=\\\"javascript:window.auth.login();\\\">Έχετε Premium; Συνδεθείτε εδώ</a></p><br />Με τη συγκατάθεσή σας, εμείς και οι <a href=\\\"javascript:Didomi.preferences.show('vendors')\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">{numberOfPartners}</a> συνεργάτες μας χρησιμοποιούμε cookies και παρόμοιες τεχνολογίες για την επεξεργασία προσωπικών δεδομένων, όπως πληροφορίες σχετικά με την επίσκεψή σας στον ιστότοπο, διευθύνσεις IP και cookie-IDs. Μπορείτε να ανακαλέσετε τη συγκατάθεσή σας ανά πάσα στιγμή κάνοντας κλικ στις \\\"ρυθμίσεις cookies\\\" στο υποσέλιδο ή μέσω της <a href=\\\"https://www.infoplaza.com/nl/disclaimer-en-privacy\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">πολιτικής cookies και απορρήτου</a> μας για περισσότερες πληροφορίες.\",\"en\":\"<h2>Choose your experience</h2>\\n<p>You have the choice to enjoy no ads for just 3.49 per year with Premium or to agree to personalised ads. <a href=\\\"javascript:window.auth.login();\\\">Do you have Premium? Log in here</a></p><br />With your consent, we and our <a href=\\\"javascript:Didomi.preferences.show('vendors')\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">{numberOfPartners}</a> partners use cookies and similar technologies to process personal data, such as information about your website visit, IP addresses, and cookie IDs. You can withdraw your consent at any time by clicking \\\"cookie settings\\\" in the footer or via our <a href=\\\"https://www.infoplaza.com/en/disclaimer-and-privacy\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">cookie and privacy policy</a> for more information.\",\"es\":\"<h2>Elige tu experiencia</h2>\\n<p>Puedes elegir entre no tener anuncios por solo 3,49 al año con Premium o aceptar anuncios personalizados. <a href=\\\"javascript:window.auth.login();\\\">Tienes Premium? Inicia sesión aquí</a>.</p><br />Con tu consentimiento, nosotros y nuestros <a href=\\\"javascript:Didomi.preferences.show('vendors')\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">{numberOfPartners}</a> socios utilizamos cookies y tecnologías similares para procesar datos personales, como información sobre tu visita al sitio web, direcciones IP e identificadores de cookies. Puedes retirar tu consentimiento en cualquier momento haciendo clic en \\\"configuración de cookies\\\" en el pie de página o a través de nuestra <a href=\\\"https://www.infoplaza.com/nl/disclaimer-en-privacy\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">política de cookies y privacidad</a> para más información.\",\"fr\":\"<h2>Choisissez votre expérience</h2>\\n<p>Vous pouvez choisir de ne pas profiter de publicité pour seulement 3,49 par an avec Premium ou d'accepter des publicités personnalisées. <a href=\\\"javascript:window.auth.login();\\\">Êtes-vous Premium ? Connectez-vous ici</a></p><br />Avec votre consentement, nous et nos <a href=\\\"javascript:Didomi.preferences.show('vendors')\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">{numberOfPartners}</a> partenaires utilisons des cookies et des technologies similaires pour le traitement des données personnelles, telles que les informations sur votre visite de notre site web, les adresses IP et les identifiants de cookies. Vous pouvez retirer votre consentement à tout moment en cliquant sur \\\"paramètres des cookies\\\" dans le pied de page ou via notre <a href=\\\"https://www.infoplaza.com/nl/disclaimer-en-privacy\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">politique de cookies et de confidentialité</a> pour plus d'informations.\",\"hr\":\"<h2>Odaberite svoje iskustvo</h2>\\n<p>Imate izbor uživati bez oglasa za samo 3,49 godišnje uz Premium ili pristati na prilagođene oglase. <a href=\\\"javascript:window.auth.login();\\\">Imate li Premium? Prijavite se ovdje</a></p><br />Uz vašu suglasnost, mi i naši <a href=\\\"javascript:Didomi.preferences.show('vendors')\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">{numberOfPartners}</a> partneri koristimo kolačiće i slične tehnologije za obradu osobnih podataka, kao što su podaci o vašem posjetu web stranici, IP adrese i ID-ovi kolačića. Svoj pristanak možete povući u bilo kojem trenutku klikom na \\\"postavke kolačića\\\" u podnožju ili putem naše <a href=\\\"https://www.infoplaza.com/nl/disclaimer-en-privacy\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">politike kolačića i privatnosti</a> za više informacija.\",\"hu\":\"<h2>Válassza ki az élményt</h2>\\n<p>Választhat, hogy nem élvezhet hirdetéseket mindössze évi 3,49 a Premiummal, vagy elfogadja a személyre szabott hirdetéseket. <a href=\\\"javascript:window.auth.login();\\\">Van Premium szolgáltatásod? Jelentkezzen be itt</a></p><br />Az Ön hozzájárulásával mi és partnereink, <a href=\\\"javascript:Didomi.preferences.show('vendors')\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">{numberOfPartners}</a>, cookie-kat és hasonló technológiákat használunk személyes adatok, például webhelylátogatásra vonatkozó adatok, IP-címek és cookie-azonosítók feldolgozásához. Hozzájárulását bármikor visszavonhatja a láblécben található \\\"cookie-beállítások\\\" lehetőségre kattintva vagy az <a href=\\\"https://www.infoplaza.com/nl/disclaimer-en-privacy\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">cookie- és adatvédelmi irányelveinken</a> keresztül további információkért.\",\"it\":\"<h2>Scegli la tua esperienza</h2>\\n<p>Puoi scegliere di non ricevere pubblicità per soli 3,49 all'anno con Premium oppure accettare annunci personalizzati. <a href=\\\"javascript:window.auth.login();\\\">Hai Premium? Accedi qui</a></p><br />Con il tuo consenso, noi e i nostri <a href=\\\"javascript:Didomi.preferences.show('vendors')\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">{numberOfPartners}</a> partner utilizziamo cookie e tecnologie simili per il trattamento dei dati personali, come informazioni sulla tua visita al sito web, indirizzi IP e ID cookie. Puoi revocare il tuo consenso in qualsiasi momento cliccando su \\\"impostazioni dei cookie\\\" nel piè di pagina o attraverso la nostra <a href=\\\"https://www.infoplaza.com/nl/disclaimer-en-privacy\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">informativa sui cookie e sulla privacy</a> per maggiori informazioni.\",\"nl\":\"<h2>Welkom, kies je ervaring</h2>\\n<p>Je hebt de keuze om voor slechts €3.49 per jaar geen advertenties te zien met\\nPremium of om akkoord te gaan met persoonlijke advertenties.<br><a href=\\\"javascript:window.auth.login();\\\" class=\\\"didomi-button\\\">Heb je al Premium? Hier inloggen</a></p><br />Met jouw toestemming gebruiken wij en onze <a href=\\\"javascript:Didomi.preferences.show('vendors')\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">{numberOfPartners}</a> partners cookies en vergelijkbare technieken voor de verwerking van persoonsgegevens, zoals gegevens over jouw websitebezoek, IP-adressen en cookie-IDs. Je kunt op elk moment jouw toestemming intrekken door in de footer te klikken op \\\"cookie instellingen\\\" of via ons <a href=\\\"https://www.infoplaza.com/nl/disclaimer-en-privacy\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">cookie- en privacybeleid</a> voor meer informatie.\",\"pl\":\"<h2>Wybierz swoje doświadczenie</h2>\\n<p>Masz wybór, aby cieszyć się brakiem reklam za jedyne 3,49 rocznie z Premium lub zgodzić się na spersonalizowane reklamy. <a href=\\\"javascript:window.auth.login();\\\">Czy masz Premium? Zaloguj się tutaj</a></p><br />Za Twoją zgodą my i nasi <a href=\\\"javascript:Didomi.preferences.show('vendors')\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">{numberOfPartners}</a> partnerzy używamy plików cookie i podobnych technologii do przetwarzania danych osobowych, takich jak informacje o Twojej wizycie na stronie, adresy IP i identyfikatory plików cookie. W każdej chwili możesz wycofać swoją zgodę, klikając \\\"ustawienia plików cookie\\\" w stopce lub odwiedzając naszą <a href=\\\"https://www.infoplaza.com/nl/disclaimer-en-privacy\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">politykę plików cookie i prywatności</a> w celu uzyskania dodatkowych informacji.\",\"pt\":\"<h2>Escolha sua experiência</h2>\\n<p>Você tem a opção de aproveitar sem anúncios por apenas 3,49 por ano com Premium ou concordar com anúncios personalizados. <a href=\\\"javascript:window.auth.login();\\\">Você tem Premium? Faça login aqui</a></p><br />Com o seu consentimento, nós e os nossos <a href=\\\"javascript:Didomi.preferences.show('vendors')\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">{numberOfPartners}</a> parceiros utilizamos cookies e tecnologias semelhantes para o processamento de dados pessoais, como informações sobre a sua visita ao site, endereços IP e IDs de cookies. Você pode retirar o seu consentimento a qualquer momento clicando em \\\"configurações de cookies\\\" no rodapé ou através da nossa <a href=\\\"https://www.infoplaza.com/nl/disclaimer-en-privacy\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">política de cookies e privacidade</a> para mais informações.\",\"sv\":\"<h2>Välj din upplevelse</h2>\\n<p>Du kan välja att inte se några annonser för bara 3,49 per år med Premium eller att acceptera personliga annonser. <a href=\\\"javascript:window.auth.login();\\\">Har du Premium? Logga in här</a></p><br />Med ditt samtycke använder vi och våra <a href=\\\"javascript:Didomi.preferences.show('vendors')\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">{numberOfPartners}</a> partners cookies och liknande tekniker för att behandla personuppgifter, såsom information om ditt besök på webbplatsen, IP-adresser och cookie-ID:n. Du kan när som helst återkalla ditt samtycke genom att klicka på \\\"cookie-inställningar\\\" i sidfoten eller via vår <a href=\\\"https://www.infoplaza.com/nl/disclaimer-en-privacy\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">cookie- och integritetspolicy</a> för mer information.\",\"tr\":\"<h2>Deneyiminizi seçin</h2>\\n<p>Premium ile yılda sadece 3,49 karşılığında reklamsız üyeliğin keyfini çıkarmayı veya kişiselleştirilmiş reklamları kabul etmeyi seçebilirsiniz. <a href=\\\"javascript:window.auth.login();\\\">Premium'unuz var mı? Buradan giriş yapın</a></p><br />Sizin izninizle, biz ve <a href=\\\"javascript:Didomi.preferences.show('vendors')\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">{numberOfPartners}</a> iş ortaklarımız, web sitesi ziyaretiniz, IP adresleri ve çerez kimlikleri gibi kişisel verilerin işlenmesi için çerezler ve benzer teknolojiler kullanıyoruz. İzninizi istediğiniz zaman alt bilgide bulunan \\\"çerez ayarları\\\"na tıklayarak veya <a href=\\\"https://www.infoplaza.com/nl/disclaimer-en-privacy\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">çerez ve gizlilik politikamız</a> üzerinden geri çekebilirsiniz.\",\"fr-BE\":\"<h2>Choisissez votre expérience</h2>\\n<p>Vous pouvez choisir de ne pas profiter de publicité pour seulement 3,49 par an avec Premium ou d'accepter des publicités personnalisées. <a href=\\\"javascript:window.auth.login();\\\">Êtes-vous Premium ? Connectez-vous ici</a></p><br />Avec votre consentement, nous et nos <a href=\\\"javascript:Didomi.preferences.show('vendors')\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">{numberOfPartners}</a> partenaires utilisons des cookies et des technologies similaires pour le traitement des données personnelles, telles que les informations sur votre visite de notre site web, les adresses IP et les identifiants de cookies. Vous pouvez retirer votre consentement à tout moment en cliquant sur \\\"paramètres des cookies\\\" dans le pied de page ou via notre <a href=\\\"https://www.infoplaza.com/nl/disclaimer-en-privacy\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">politique de cookies et de confidentialité</a> pour plus d'informations.\",\"nl-BE\":\"<h2>Welkom, kies je ervaring</h2>\\n<p>Je hebt de keuze om voor slechts 3.49 per jaar geen advertenties te zien met Premium of om akkoord te gaan met persoonlijke advertenties.<br><a href=\\\"javascript:window.auth.login();\\\">Heb je al Premium? Hier inloggen</a></p><br />Met jouw toestemming gebruiken wij en onze <a href=\\\"javascript:Didomi.preferences.show('vendors')\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">{numberOfPartners}</a> partners cookies en vergelijkbare technieken voor de verwerking van persoonsgegevens, zoals gegevens over jouw websitebezoek, IP-adressen en cookie-IDs. Je kunt op elk moment jouw toestemming intrekken door in de footer te klikken op \\\"cookie instellingen\\\" of via ons <a href=\\\"https://www.infoplaza.com/nl/disclaimer-en-privacy\\\" class=\\\"didomi-notice-view-partners-link-in-text\\\">cookie- en privacybeleid</a> voor meer informatie.\"},\"dismiss\":{\"en\":\"Free with personalized ads\",\"nl\":\"Gratis met persoonlijke advertenties\"},\"deny\":{\"en\":\"Ad-Free Premium (€3.49 per year)\",\"nl\":\"Advertentievrij Premium (€3,49 per jaar)\"},\"learnMore\":null,\"dismissAriaLabel\":{\"en\":\"Free with personalized ads\",\"nl\":\"Gratis met persoonlijke advertenties\"},\"denyAriaLabel\":{\"en\":\"Ad-Free Premium (€3.49 per year)\",\"nl\":\"Advertentievrij Premium (€3,49 per jaar)\"},\"learnMoreAriaLabel\":{\"en\":\"Change preferences\"},\"activeElements\":[\"learnMore\",\"deny\",\"dismiss\"],\"description\":{\"firstParagraph\":\"Your custom text for the first paragraph.\",\"secondParagraph\":\"Your custom text for the second paragraph.\"}},\"partnersLink\":{\"enabled\":true},\"enable\":true,\"type\":\"optin\",\"denyOptions\":{\"button\":\"primary\"},\"denyAsPrimary\":true,\"denyAppliesToLI\":true},\"languages\":{\"default\":\"en\",\"enabled\":[\"nl\",\"hr\",\"nl-BE\",\"en\",\"fr\",\"fr-BE\",\"de\",\"el\",\"hu\",\"it\",\"pl\",\"pt\",\"es\",\"tr\",\"sv\"]},\"tagManager\":{\"provider\":\"gtm\"},\"preferences\":{\"categories\":[{\"id\":\"8ipUPjzp\",\"name\":{\"nl\":\"Om het platform goed te laten werken (functioneel)\"},\"type\":\"category\",\"children\":[{\"type\":\"purpose\",\"purposeId\":\"functional\"}],\"expanded\":true,\"description\":{\"nl\":\"\"}},{\"id\":\"wKc8Xt7W\",\"name\":{\"nl\":\"Om het platform te meten (analytisch)\"},\"type\":\"category\",\"children\":[{\"type\":\"purpose\",\"purposeId\":\"cooki