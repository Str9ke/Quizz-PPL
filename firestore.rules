rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Documents keyed "<syncCode>__<dossierId>" ; syncCode = l'UID Firebase Auth de son
    // propriétaire dès qu'une session est active (voir navlog.html _getSyncCode()), donc
    // resource.data.syncCode == request.auth.uid restreint bien chaque dossier à son auteur.
    match /navlog_dossiers/{document} {
      allow read, update, delete: if request.auth != null
        && resource.data.syncCode == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.syncCode == request.auth.uid;
    }
    match /quizProgress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Sous-collection dédiée à l'historique des réponses (statusLog), un document par
      // question — chaque document a sa PROPRE limite Firestore de 1 Mio, indépendante du
      // document principal ci-dessus. Les règles ne sont PAS héritées automatiquement par
      // les sous-collections : sans cette entrée, toute lecture/écriture y échouerait avec
      // permission-denied.
      match /history/{questionKey} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /navlogNotes/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
